# Cheese Blockchain Configuration
CHEESE_BLOCKCHAIN_API_URL=http://165.22.252.113:8080
CHEESE_BLOCKCHAIN_API_KEY=your_api_key_here
# Required before any non-local deployment. If this is left blank, decide
# explicitly in server.js whether the blockchain notary endpoint should
# fail closed (reject writes) rather than silently send unauthenticated
# requests to a plaintext HTTP endpoint.

# Server Configuration
PORT=3000
NODE_ENV=development

# Session Store
# Use a Postgres-backed store (e.g. connect-pg-simple) in production —
# express-session's default MemoryStore leaks memory and wipes every
# logged-in user's session on each redeploy.
SESSION_STORE=postgres

# Farmers Consensus Configuration
FARMERS_CONSENSUS_TREASURY_WALLET=replace_with_your_own_wallet_address
REGISTRATION_REWARD_AMOUNT=10
HARVEST_VERIFICATION_REWARD=25

# Revenue Configuration
TRANSACTION_FEE=0.5
PREMIUM_TIER_FEE=2.0
HARVEST_VERIFICATION_FEE=1.5
BUYER_REGISTRATION_FEE=1.0
BUYER_PREMIUM_FEE=3.0
BUYER_MATCHING_FEE=0.25

# Admin Configuration
# Treat this as a bootstrap-only account. Once more than one person needs
# admin access (e.g. officials in more than one province), migrate to
# per-person rows in `users` (user_type = 'admin', bcrypt-hashed password)
# so logins are individually auditable and revocable instead of one
# shared credential pair.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_this_to_a_long_random_password
ADMIN_SESSION_SECRET=change_this_to_a_long_random_string

# JWT Configuration
# Decide on ONE session/auth mechanism — Postgres-backed session OR JWT,
# not both — and remove the unused dependency once you've picked.
JWT_SECRET=change_this_to_a_long_random_string

# Database Configuration
DATABASE_URL=postgresql://user:password@localhost:5432/farmers_consensus
